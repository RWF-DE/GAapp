# apps/web/.env.local にコピーして使う（.env.local はコミットしない）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub Pages 向けビルドだけ /GAapp のように指定する。ローカルと E2E は空
NEXT_PUBLIC_BASE_PATH=
# 任意：Google のアカウント選択を学校のドメインに絞るヒント（拒否は DB のフック）
NEXT_PUBLIC_GOOGLE_HD_HINT=
# ローカル専用：メール＋パスワードのテスト用ログインを出す（Supabase がローカルのときだけ出る。本番では設定しない）
NEXT_PUBLIC_ENABLE_TEST_LOGIN=true
