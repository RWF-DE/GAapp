{
  "name": "gaapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gaapp/web dev",
    "build": "pnpm --filter @gaapp/web build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:emails": "node scripts/check-emails.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types": "node scripts/gen-types.mjs --check",
    "check:no-test-login": "node scripts/check-no-test-login.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "globals": "17.13.0",
    "oxfmt": "0.74.0",
    "serve": "14.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
