-- テスト用のデータ（各テストファイルの \ir _helpers/personas.psql の後に \ir _helpers/fixture.psql）。supabase db reset の後（seed の T02・T04・T05 が入った状態）で流す。
-- seed とぶつからないように：品目は insert せず seed の9件をコードで引く。場所・建物の名前は pgtap- で始め、
-- ペルソナのメールは @pgtap.test（seed は @example.test）。消してよい品目・場所はここで作った使い捨てのもの（spare、R4）だけにする。
insert into tests.ids select code, id from public.items
where code in ('desk', 'desk_ng', 'chair', 'chair_ng', 'caster_desk', 'blue_chair', 'long_desk_3', 'long_desk_2', 'lectern');
do $$
begin
  if (select count(*) from tests.ids) <> 9 then
    raise exception 'seed の品目9件がない。supabase db reset で seed を入れてからテストを流す';
  end if;
end $$;
-- 権限表の items の delete で消す品目（seed の品目は在庫・申請から参照されるので消せない）
with i as (insert into public.items (code, name, sort_order) values ('pgtap_spare', 'pgTAP 削除用', 99) returning id)
insert into tests.ids select 'spare', id from i;

-- head（Y1 の総務部門長）と deputy（Y1 の総務副部門長）は T15 で足した（今までのペルソナの後ろに作る）
select tests.create_user(n) from unnest(array['admin','staff','rep','rep2','viewer','outsider','admin2','head','deputy']) n;

with y as (
  insert into public.years (label, festival_start, request_close_at, status)
  values ('T-Y1', date '2027-10-16', now() + interval '1 day', 'requesting'),
         ('T-Y2', date '2026-10-16', null, 'preparing')        -- Y2 は Y1 より前の年度（Y1 が最新。create_year_from の条件）
  returning id, label)
insert into tests.ids select case label when 'T-Y1' then 'Y1' else 'Y2' end, id from y;
do $$
begin
  -- Y1 を最新の年度にする（create_year_from の正常系のため）。seed の年度（R8：2026-10-17）より後でなければならない
  if exists (select 1 from public.years y where y.label <> 'T-Y1' and y.festival_start >= date '2027-10-16') then
    raise exception 'seed に T-Y1（2027-10-16）より後の年度がある。fixture の1日目を後ろにずらす';
  end if;
end $$;

with r as (
  insert into public.rooms (name, kind, building, floor, is_storage, sort_order) values
    ('pgtap-R1', 'room', 'pgtap棟A', 1, true, 1),
    ('pgtap-R2', 'room', 'pgtap棟A', 2, true, 2),
    ('pgtap-R3', 'room', 'pgtap棟B', 1, true, 3),
    ('pgtap-R4', 'room', 'pgtap棟B', 2, false, 4)        -- R4 はどこからも参照しない（権限表の rooms の delete で消す）
  returning id, name)
insert into tests.ids select substr(name, 7), id from r;

insert into public.room_years (year_id, room_id, usable) values (tests.id('Y1'), tests.id('R3'), false);

with g as (
  insert into public.groups (year_id, name, category, location_room_id, sort_order) values
    (tests.id('Y1'), 'T-G1', 'stall', tests.id('R1'), 1),
    (tests.id('Y1'), 'T-G2', 'department', null, 2),
    (tests.id('Y2'), 'T-G3', 'stall', tests.id('R1'), 1),
    (tests.id('Y1'), 'T-G4', 'department', null, 4)       -- viewer が副店長を兼ねる（閲覧のみは同じ年度の団体代表を兼ねられる。D-49）
  returning id, name)
insert into tests.ids select substr(name, 3), id from g;

insert into public.year_roles (year_id, user_id, role) values
  (tests.id('Y1'), tests.id('admin'), 'admin'),
  (tests.id('Y1'), tests.id('head'), 'head'),
  (tests.id('Y1'), tests.id('deputy'), 'deputy_head'),
  (tests.id('Y1'), tests.id('staff'), 'staff'),
  (tests.id('Y1'), tests.id('viewer'), 'viewer'),
  (tests.id('Y2'), tests.id('admin2'), 'admin'),
  (tests.id('Y2'), tests.id('rep'), 'viewer');            -- rep が Y2 では viewer（year_roles(own) の rep の中身のある検査用）
-- 兼任の禁止（D-49）：staff は Y1 の団体代表になれないので、Y2 の G3 の店長にする（違う年度ならよい。group_members(own) の
-- staff の中身のある検査用）。viewer は Y1 の G4 の副店長（閲覧のみは兼ねられる。副店長も店長と同じ権限）
insert into public.group_members (group_id, user_id, role) values
  (tests.id('G1'), tests.id('rep'), 'manager'), (tests.id('G2'), tests.id('rep2'), 'manager'),
  (tests.id('G3'), tests.id('staff'), 'manager'), (tests.id('G4'), tests.id('viewer'), 'deputy_manager');

insert into public.invitations (year_id, email, role, used_at) values
  (tests.id('Y1'), 'viewer@pgtap.test', 'viewer', now()),
  (tests.id('Y1'), 'staff@pgtap.test', 'staff', now()),            -- invitations(own) の staff の中身のある検査用
  (tests.id('Y1'), 'someone@pgtap.test', 'staff', null);
-- 未使用の admin の招待（T15）。部門長・副部門長には読めず、上書きも取り消しもできない（011・024）
with i as (insert into public.invitations (year_id, email, role) values (tests.id('Y1'), 'invited_admin@pgtap.test', 'admin') returning id)
insert into tests.ids select 'INV_ADMIN', id from i;
insert into public.invitations (year_id, email, group_id, group_role, used_at) values
  (tests.id('Y1'), 'rep@pgtap.test', tests.id('G1'), 'manager', now());

insert into public.stocks (year_id, room_id, item_id, count) values
  (tests.id('Y1'), tests.id('R1'), tests.id('desk'), 10),
  (tests.id('Y1'), tests.id('R2'), tests.id('desk'), 5),
  (tests.id('Y1'), tests.id('R2'), tests.id('caster_desk'), 5),
  (tests.id('Y1'), tests.id('R3'), tests.id('desk'), 3);

insert into public.request_submissions (group_id, submitted_at) values
  (tests.id('G1'), now()), (tests.id('G2'), now());
insert into public.requests (group_id, item_id, count) values
  (tests.id('G1'), tests.id('desk'), 6), (tests.id('G2'), tests.id('desk'), 3);

with r as (
  insert into public.rules (year_id, code, kind, params) values
    (tests.id('Y1'), 'S05', 'source_restrict',
     jsonb_build_object('group', tests.id('G2'), 'items', jsonb_build_array('desk'), 'rooms', jsonb_build_array(tests.id('R2'))))
  returning id)
insert into tests.ids select 'RULE1', id from r;

insert into public.substitution_consents (group_id, from_item_id, to_item_id, status)
values (tests.id('G1'), tests.id('desk'), tests.id('caster_desk'), 'not_asked');

with a as (
  insert into public.allocations (year_id, source_room_id, group_id, item_id, requested_item_id, count, is_keep, origin)
  values (tests.id('Y1'), tests.id('R1'), tests.id('G1'), tests.id('desk'), tests.id('desk'), 4, true, 'auto'),
         (tests.id('Y1'), tests.id('R2'), tests.id('G1'), tests.id('caster_desk'), tests.id('desk'), 2, false, 'auto'),
         (tests.id('Y1'), tests.id('R2'), tests.id('G2'), tests.id('desk'), tests.id('desk'), 3, false, 'auto')
  returning id, group_id, item_id)
insert into tests.ids
select case when group_id = tests.id('G2') then 'A_G2'
            when item_id = tests.id('caster_desk') then 'A_G1_SWAP' else 'A_G1_KEEP' end, id from a;

with s as (
  insert into public.slots (year_id, day, label) values (tests.id('Y1'), 'day_minus1', '前日 9:00') returning id)
insert into tests.ids select 'SLOT1', id from s;
with d as (
  insert into public.deliveries (year_id, group_id, kind, slot_id) values
    (tests.id('Y1'), tests.id('G1'), 'furniture', tests.id('SLOT1')),
    (tests.id('Y1'), tests.id('G2'), 'furniture', null)
  returning id, group_id)
insert into tests.ids select case when group_id = tests.id('G1') then 'D_G1' else 'D_G2' end, id from d;

insert into public.distance_overrides (building_a, building_b, cost) values ('pgtap棟A', 'pgtap棟B', 4);

-- お知らせ（T17。D-53）：宛先ごとに Y1・Y2 に置く（011 の権限表・013 の D-47・025 の RPC・030 の招待のない人で読む）。
-- 書いた人は created_by・updated_by に直接入れる（auth.uid() のない書き込みでは set_actor は入れた値のまま。D-10）。
-- N_G12 は G1・G2 あて（rep には G1 の行だけ、rep2 には G2 の行だけが見える）、N_G4 は rep の団体でない G4（viewer が副店長）あて。
-- Y2 の N_Y2_G3 は staff が店長の G3 あて（staff は Y2 では総務でない）。名前は題名の「T-」の後ろ
with n as (
  insert into public.notices (year_id, audience, title, pinned, created_by, updated_by) values
    (tests.id('Y1'), 'soumu', 'T-N_SOUMU', false, tests.id('staff'), tests.id('staff')),
    (tests.id('Y1'), 'all_groups', 'T-N_ALL', true, tests.id('head'), tests.id('head')),
    (tests.id('Y1'), 'groups', 'T-N_G1', false, tests.id('head'), tests.id('head')),
    (tests.id('Y1'), 'groups', 'T-N_G12', false, tests.id('deputy'), tests.id('deputy')),
    (tests.id('Y1'), 'groups', 'T-N_G4', false, tests.id('admin'), tests.id('admin')),
    (tests.id('Y2'), 'soumu', 'T-N_Y2_SOUMU', false, tests.id('admin2'), tests.id('admin2')),
    (tests.id('Y2'), 'all_groups', 'T-N_Y2_ALL', false, tests.id('admin2'), tests.id('admin2')),
    (tests.id('Y2'), 'groups', 'T-N_Y2_G3', false, tests.id('admin2'), tests.id('admin2'))
  returning id, title)
insert into tests.ids select substr(title, 3), id from n;
insert into public.notice_groups (notice_id, year_id, group_id) values
  (tests.id('N_G1'), tests.id('Y1'), tests.id('G1')),
  (tests.id('N_G12'), tests.id('Y1'), tests.id('G1')), (tests.id('N_G12'), tests.id('Y1'), tests.id('G2')),
  (tests.id('N_G4'), tests.id('Y1'), tests.id('G4')),
  (tests.id('N_Y2_G3'), tests.id('Y2'), tests.id('G3'));

-- 予定と締切（T18。D-54）：対象ごとに Y1・Y2 に置く（011 の権限表・013 の D-47・030 の招待のない人で読む）。
-- 書いた人は created_by・updated_by に直接入れる（auth.uid() のない書き込みでは set_actor は入れた値のまま。D-10）。
-- E_ALL と E_Y2_ALL は終日（Asia/Tokyo の 00:00。E_ALL は2日間）。Y2 の団体・全員は、Y2 の閲覧のみの rep と、Y2 の G3 の店長の
-- staff が読む（staff は Y2 では総務でない）。名前は題名の「T-」の後ろ
with e as (
  insert into public.events (year_id, kind, audience, title, starts_at, ends_at, all_day, created_by, updated_by) values
    (tests.id('Y1'), 'event', 'soumu', 'T-E_SOUMU', '2027-10-14 09:00+09', '2027-10-14 10:00+09', false, tests.id('head'), tests.id('head')),
    (tests.id('Y1'), 'deadline', 'groups', 'T-E_GROUPS', '2027-09-30 17:00+09', null, false, tests.id('admin'), tests.id('admin')),
    (tests.id('Y1'), 'event', 'all', 'T-E_ALL', '2027-10-16 00:00+09', '2027-10-17 00:00+09', true, tests.id('deputy'), tests.id('deputy')),
    (tests.id('Y2'), 'deadline', 'soumu', 'T-E_Y2_SOUMU', '2026-10-01 12:00+09', null, false, tests.id('admin2'), tests.id('admin2')),
    (tests.id('Y2'), 'event', 'groups', 'T-E_Y2_GROUPS', '2026-10-14 13:00+09', '2026-10-14 15:00+09', false, tests.id('admin2'), tests.id('admin2')),
    (tests.id('Y2'), 'event', 'all', 'T-E_Y2_ALL', '2026-10-16 00:00+09', null, true, tests.id('admin2'), tests.id('admin2'))
  returning id, title)
insert into tests.ids select substr(title, 3), id from e;

-- シフト・作業（T20。D-56）：Y1・Y2 に持ち場・時間枠・ます・割り当て・作業を置く（011 の権限表・013 の D-47・020 の複製・021 のロールを
-- 外したとき・028 の RPC・030 の招待のない人で読む）。Y1 の総務は admin・head・deputy・staff、Y2 の総務は admin2 だけ（rep は Y2 の閲覧のみ、
-- staff は Y2 の G3 の店長）。Y1 の SL1・SL2 は隣り合う時間枠（9:00〜10:00 と 10:00〜11:00）。DU3・DU_Y2B はますのない持ち場、SL_Y2B は
-- 割り当てのないますを持つ時間枠（011 で消す・足す）。作業の書いた人は created_by・updated_by に直接入れる（auth.uid() のない書き込みでは
-- set_actor は入れた値のまま。D-10）。持ち場の名前は「T-」で始め（年度が違えば同じ名前を置ける）、作業の名前は題名の「T-」の後ろ
with d as (
  insert into public.shift_duties (year_id, name, place, note, sort_order) values
    (tests.id('Y1'), 'T-受付', '正門のテント', '来場者の案内', 1),
    (tests.id('Y1'), 'T-運搬', null, null, 2),
    (tests.id('Y1'), 'T-予備', null, null, 3),
    (tests.id('Y2'), 'T-受付', null, null, 1),
    (tests.id('Y2'), 'T-予備', null, null, 2)
  returning id, year_id, name)
insert into tests.ids
select case when year_id = tests.id('Y1') then case name when 'T-受付' then 'DU1' when 'T-運搬' then 'DU2' else 'DU3' end
            else case name when 'T-受付' then 'DU_Y2' else 'DU_Y2B' end end, id from d;
with s as (
  insert into public.shift_slots (year_id, starts_at, ends_at) values
    (tests.id('Y1'), '2027-10-15 09:00+09', '2027-10-15 10:00+09'),
    (tests.id('Y1'), '2027-10-15 10:00+09', '2027-10-15 11:00+09'),
    (tests.id('Y2'), '2026-10-15 09:00+09', '2026-10-15 10:00+09'),
    (tests.id('Y2'), '2026-10-15 10:00+09', '2026-10-15 11:00+09')
  returning id, year_id, starts_at)
insert into tests.ids
select case when year_id = tests.id('Y1') then case when starts_at = '2027-10-15 09:00+09' then 'SL1' else 'SL2' end
            else case when starts_at = '2026-10-15 09:00+09' then 'SL_Y2' else 'SL_Y2B' end end, id from s;
insert into public.shift_needs (year_id, slot_id, duty_id, required_count) values
  (tests.id('Y1'), tests.id('SL1'), tests.id('DU1'), 2),
  (tests.id('Y1'), tests.id('SL1'), tests.id('DU2'), 1),
  (tests.id('Y1'), tests.id('SL2'), tests.id('DU1'), 1),
  (tests.id('Y2'), tests.id('SL_Y2'), tests.id('DU_Y2'), 1),
  (tests.id('Y2'), tests.id('SL_Y2B'), tests.id('DU_Y2'), 1);
insert into public.shift_assignments (year_id, slot_id, duty_id, user_id) values
  (tests.id('Y1'), tests.id('SL1'), tests.id('DU1'), tests.id('staff')),
  (tests.id('Y1'), tests.id('SL1'), tests.id('DU2'), tests.id('head')),
  (tests.id('Y2'), tests.id('SL_Y2'), tests.id('DU_Y2'), tests.id('admin2'));
with t as (
  insert into public.tasks (year_id, title, note, assignee_id, due_at, status, created_by, updated_by) values
    (tests.id('Y1'), 'T-TK_STAFF', '机の数を数える', tests.id('staff'), '2027-10-10 17:00+09', 'todo', tests.id('head'), tests.id('head')),
    (tests.id('Y1'), 'T-TK_NONE', null, null, null, 'todo', tests.id('deputy'), tests.id('deputy')),
    (tests.id('Y1'), 'T-TK_DONE', null, tests.id('head'), '2027-10-01 17:00+09', 'done', tests.id('admin'), tests.id('head')),
    (tests.id('Y2'), 'T-TK_Y2', null, tests.id('admin2'), null, 'doing', tests.id('admin2'), tests.id('admin2'))
  returning id, title)
insert into tests.ids select substr(title, 3), id from t;
