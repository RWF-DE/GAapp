    (tests.id('Y2'), 'T-TK_Y2', null, tests.id('admin2'), null, 'doing', tests.id('admin2'), tests.id('admin2'))
  returning id, title)
insert into tests.ids select substr(title, 3), id from t;

-- テント等の貸し出し（T21。D-57）：Y1・Y2 に備品・申請・割り当て・記録・確定の印を置く（011 の権限表・013 の D-47・020 の複製・
-- 029 の RPC・030 の招待のない人で読む）。名前は「T-」で始める。書いた人は updated_by・confirmed_by に直接入れる（auth.uid() のない
-- 書き込みでは set_actor は入れた値のまま。D-10）。
-- Y1（受付中・割り当ての確定前）：テント（在庫 3。模擬店・部門）は申請 4（G1 が 2・G2 が 2）で在庫を超える。重し（在庫 20・既定の区分）、
-- 三方幕（在庫 2・模擬店だけ）、予備（在庫 5。どこからも参照しない。011 の権限表の削除で消す）。割り当ては G1 のテント 2・重し 8
-- （G2 のテントと G1 の三方幕は未入力）。記録は G1 のテント（渡した 2・返った 1）と重し（8・8・うち破損 1。メモつき）。
-- Y2（準備中・割り当ての確定後）：G3（staff が店長）がテントを 1 申請し、1 を割り当て、1 を渡した（返っていない）。確定は admin2。
-- 名前は tests.ids の LI_TENT・LI_WEIGHT・LI_CURTAIN・LI_SPARE・LI_Y2_TENT
with li as (
  insert into public.lending_items (year_id, name, unit, stock, requestable_categories, sort_order) values
    (tests.id('Y1'), 'T-テント', '張', 3, '{stall,department}', 1),
    (tests.id('Y1'), 'T-重し', '個', 20, default, 2),
    (tests.id('Y1'), 'T-三方幕', '枚', 2, '{stall}', 3),
    (tests.id('Y1'), 'T-予備', '個', 5, default, 9),
    (tests.id('Y2'), 'T-テント', '張', 2, default, 1)
  returning id, year_id, name)
insert into tests.ids
select case when year_id = tests.id('Y2') then 'LI_Y2_TENT' when name = 'T-テント' then 'LI_TENT'
            when name = 'T-重し' then 'LI_WEIGHT' when name = 'T-三方幕' then 'LI_CURTAIN' else 'LI_SPARE' end, id
from li;
insert into public.lending_requests (group_id, lending_item_id, year_id, count, updated_by) values
  (tests.id('G1'), tests.id('LI_TENT'), tests.id('Y1'), 2, tests.id('rep')),
  (tests.id('G2'), tests.id('LI_TENT'), tests.id('Y1'), 2, tests.id('rep2')),
  (tests.id('G1'), tests.id('LI_WEIGHT'), tests.id('Y1'), 8, tests.id('rep')),
  (tests.id('G1'), tests.id('LI_CURTAIN'), tests.id('Y1'), 1, tests.id('rep')),
  (tests.id('G3'), tests.id('LI_Y2_TENT'), tests.id('Y2'), 1, tests.id('staff'));
insert into public.lending_assignments (group_id, lending_item_id, year_id, count, updated_by) values
  (tests.id('G1'), tests.id('LI_TENT'), tests.id('Y1'), 2, tests.id('head')),
  (tests.id('G1'), tests.id('LI_WEIGHT'), tests.id('Y1'), 8, tests.id('head')),
  (tests.id('G3'), tests.id('LI_Y2_TENT'), tests.id('Y2'), 1, tests.id('admin2'));
insert into public.lending_records (group_id, lending_item_id, year_id, lent_count, returned_count, damaged_count, note, updated_by) values
  (tests.id('G1'), tests.id('LI_TENT'), tests.id('Y1'), 2, 1, 0, null, tests.id('staff')),
  (tests.id('G1'), tests.id('LI_WEIGHT'), tests.id('Y1'), 8, 8, 1, 'T-メモ', tests.id('staff')),
  (tests.id('G3'), tests.id('LI_Y2_TENT'), tests.id('Y2'), 1, 0, 0, null, tests.id('admin2'));
insert into public.lending_years (year_id, confirmed_at, confirmed_by) values (tests.id('Y2'), now(), tests.id('admin2'));

-- 備品（数えるだけ。T22。D-60）：名前の一覧は年度をまたぐ（0021 が最初から出す4つ〔ゴミ箱・延長コード・扇風機・オレンジ椅子〕を入れる）。
-- fixture は「その他」の物を2つ足す（CI_WHITE は数のある物、CI_SPARE はどこからも参照しない。011 の権限表の削除で消す）。名前は「T-」で
-- 始める。数は Y1 の R1（ゴミ箱 5・T-白椅子 2）と Y2 の R1（ゴミ箱 3。Y2 の総務 admin2 が読む。前年の数の確かめにも使う）。
-- 名前は tests.ids の CI_TRASH（0021 のゴミ箱）・CI_WHITE・CI_SPARE
insert into tests.ids select 'CI_TRASH', id from public.count_items where name = 'ゴミ箱';
with ci as (
  insert into public.count_items (name, sort_order) values ('T-白椅子', 10), ('T-予備', 11) returning id, name)
insert into tests.ids select case name when 'T-白椅子' then 'CI_WHITE' else 'CI_SPARE' end, id from ci;
insert into public.count_stocks (year_id, room_id, count_item_id, count) values
  (tests.id('Y1'), tests.id('R1'), tests.id('CI_TRASH'), 5),
  (tests.id('Y1'), tests.id('R1'), tests.id('CI_WHITE'), 2),
  (tests.id('Y2'), tests.id('R1'), tests.id('CI_TRASH'), 3);

-- 品目の画像（T23。D-61）：画像の予約を1つ置く（011 の権限表で読む）。IU_STAFF は staff の T-白椅子の予約で、期限が切れている（032 の
-- 予約の数の上限・bucket の合計に数えない）。物（Storage）は置かない（027・013 の Storage の比べ方を変えない）。予約は RPC だけで書く表
-- なので postgres で直接入れる
insert into tests.ids values ('IU_STAFF', gen_random_uuid());
insert into public.item_image_uploads (id, count_item_id, object_path, content_type, created_by, expires_at)
values (tests.id('IU_STAFF'), tests.id('CI_WHITE'), 'count-items/' || tests.id('CI_WHITE') || '/' || tests.id('IU_STAFF') || '.webp',
        'image/webp', tests.id('staff'), now() - interval '1 day');

-- 現状復帰の写真（T25。D-63）：写真を Y1・Y2 の R1 に1枚ずつ（RP_Y1・RP_Y2）と、写真の予約を1つ（RU_STAFF。staff の Y1・R1 の予約で、
-- 期限が切れている）置く（011 の権限表・013 の D-47 で読む）。物（Storage）は置かない（027・013 の Storage の比べ方を変えない）。
-- どちらも RPC だけで書く表なので postgres で直接入れる。Y1 の prev_year_id は入れない（前の年度の確かめは 034・013 で入れる）
insert into tests.ids values ('RP_Y1', gen_random_uuid()), ('RP_Y2', gen_random_uuid()), ('RU_STAFF', gen_random_uuid());
insert into public.room_photos (id, year_id, room_id, object_path, memo, sort_order, created_by) values
  (tests.id('RP_Y1'), tests.id('Y1'), tests.id('R1'), tests.id('Y1') || '/' || tests.id('R1') || '/' || tests.id('RP_Y1') || '.webp', 'T-黒板の前', 0, tests.id('staff')),
  (tests.id('RP_Y2'), tests.id('Y2'), tests.id('R1'), tests.id('Y2') || '/' || tests.id('R1') || '/' || tests.id('RP_Y2') || '.webp', '', 0, tests.id('admin2'));
insert into public.room_photo_uploads (id, year_id, room_id, object_path, content_type, created_by, expires_at)
values (tests.id('RU_STAFF'), tests.id('Y1'), tests.id('R1'), tests.id('Y1') || '/' || tests.id('R1') || '/' || tests.id('RU_STAFF') || '.webp',
        'image/webp', tests.id('staff'), now() - interval '1 day');
